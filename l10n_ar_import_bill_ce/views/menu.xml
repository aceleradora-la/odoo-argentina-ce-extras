<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción para importar facturas desde Excel -->
    <record id="action_import_bills_from_excel" model="ir.actions.act_window">
        <field name="name">Importar Facturas desde Excel</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">afip.import.wizard.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <!-- Menú padre para agrupar funcionalidades de impuestos argentinos -->
    <!-- Se crea aquí también para que funcione si este módulo se instala primero -->
    <!-- noupdate evita que se sobrescriba si ya existe (creado por otro módulo) -->
    <data noupdate="1">
        <record id="menu_impuestos_argentina" model="ir.ui.menu">
            <field name="name">Impuestos Argentina</field>
            <field name="parent_id" ref="account.menu_finance_entries"/>
            <field name="sequence">15</field>
            <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
        </record>
    </data>

    <!-- Menú en Impuestos Argentina -->
    <menuitem
        id="menu_import_bills_from_excel"
        name="Importar Facturas desde Excel"
        parent="menu_impuestos_argentina"
        action="action_import_bills_from_excel"
        sequence="20"
        groups="account.group_account_user"/>
</odoo>


