<?xml version="1.0" encoding="utf-8"?>
<!-- Estructura por defecto del Estado de Resultados, basada en el plan de
     cuentas argentino (4.x ingresos, 5.x gastos). noupdate: el usuario la
     edita en Configuración > Estructuras Estado de Resultados. -->
<odoo noupdate="1">
    <record id="pl_structure_ar" model="l10n_ar.pl.structure">
        <field name="name">Estado de Resultados (AR)</field>
    </record>

    <record id="pl_line_vn" model="l10n_ar.pl.structure.line">
        <field name="structure_id" ref="pl_structure_ar"/>
        <field name="sequence">10</field>
        <field name="code">VN</field>
        <field name="name">Ventas netas de bienes y servicios</field>
        <field name="line_type">accounts</field>
        <field name="account_prefixes">4.1</field>
    </record>
    <record id="pl_line_cv" model="l10n_ar.pl.structure.line">
        <field name="structure_id" ref="pl_structure_ar"/>
        <field name="sequence">20</field>
        <field name="code">CV</field>
        <field name="name">Costo de venta de bienes y servicios</field>
        <field name="line_type">accounts</field>
        <field name="account_prefixes">5.1.1</field>
    </record>
    <record id="pl_line_gb" model="l10n_ar.pl.structure.line">
        <field name="structure_id" ref="pl_structure_ar"/>
        <field name="sequence">30</field>
        <field name="code">GB</field>
        <field name="name">Ganancia (Pérdida) bruta</field>
        <field name="line_type">formula</field>
        <field name="formula">VN + CV</field>
        <field name="style">total</field>
    </record>
    <record id="pl_line_gc" model="l10n_ar.pl.structure.line">
        <field name="structure_id" ref="pl_structure_ar"/>
        <field name="sequence">40</field>
        <field name="code">GC</field>
        <field name="name">Gastos de comercialización</field>
        <field name="line_type">accounts</field>
        <field name="account_prefixes">5.1.2</field>
    </record>
    <record id="pl_line_ga" model="l10n_ar.pl.structure.line">
        <field name="structure_id" ref="pl_structure_ar"/>
        <field name="sequence">50</field>
        <field name="code">GA</field>
        <field name="name">Gastos de administración</field>
        <field name="line_type">accounts</field>
        <field name="account_prefixes">5.1.3</field>
    </record>
    <record id="pl_line_og" model="l10n_ar.pl.structure.line">
        <field name="structure_id" ref="pl_structure_ar"/>
        <field name="sequence">60</field>
        <field name="code">OG</field>
        <field name="name">Otros gastos</field>
        <field name="line_type">accounts</field>
        <field name="account_prefixes">5.1.4</field>
    </record>
    <record id="pl_line_rf" model="l10n_ar.pl.structure.line">
        <field name="structure_id" ref="pl_structure_ar"/>
        <field name="sequence">70</field>
        <field name="code">RF</field>
        <field name="name">Resultados financieros y por tenencia</field>
        <field name="line_type">accounts</field>
        <field name="account_prefixes">5.1.5</field>
    </record>
    <record id="pl_line_oi" model="l10n_ar.pl.structure.line">
        <field name="structure_id" ref="pl_structure_ar"/>
        <field name="sequence">80</field>
        <field name="code">OI</field>
        <field name="name">Otros ingresos</field>
        <field name="line_type">accounts</field>
        <field name="account_prefixes">4.2</field>
    </record>
    <record id="pl_line_rn" model="l10n_ar.pl.structure.line">
        <field name="structure_id" ref="pl_structure_ar"/>
        <field name="sequence">90</field>
        <field name="code">RN</field>
        <field name="name">Resultado neto</field>
        <field name="line_type">formula</field>
        <field name="formula">GB + GC + GA + OG + RF + OI</field>
        <field name="style">total</field>
    </record>
</odoo>
