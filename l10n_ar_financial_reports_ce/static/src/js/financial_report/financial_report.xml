<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_ar_financial_reports_ce.Report" owl="1">
        <div class="o_action o_arfr_report" t-ref="root">
            <div class="o_control_panel">
                <div class="o_control_panel_main d-flex align-items-center flex-nowrap gap-2 p-2 o_arfr_toolbar">
                    <button class="btn btn-sm btn-primary" t-on-click="exportPdf">PDF</button>
                    <button class="btn btn-sm btn-secondary" t-on-click="exportXlsx">XLSX</button>
                    <h5 class="mb-0 me-2 text-nowrap" t-if="header"><t t-esc="header.title"/></h5>

                    <input type="text" class="form-control form-control-sm"
                           style="width: 140px;"
                           placeholder="Buscar..." t-model="state.filterText"/>

                    <t t-if="header">
                        <!-- Fechas -->
                        <t t-if="header.is_aged">
                            <div class="input-group input-group-sm w-auto">
                                <span class="input-group-text">Al</span>
                                <input type="date" class="form-control form-control-sm"
                                       t-att-value="header.date_at"
                                       t-on-change="(ev) => this.onDateChange('date_at', ev)"/>
                            </div>
                            <select class="form-select form-select-sm w-auto"
                                    t-on-change="(ev) => this.updateFilter('based_on', ev.target.value)">
                                <option value="date_maturity" t-att-selected="header.based_on === 'date_maturity'">Según fecha límite</option>
                                <option value="date" t-att-selected="header.based_on === 'date'">Según fecha de factura</option>
                            </select>
                            <div class="input-group input-group-sm w-auto" style="max-width: 110px;">
                                <input type="number" min="1" class="form-control form-control-sm"
                                       t-att-value="header.period_length"
                                       t-on-change="onPeriodLengthChange"/>
                                <span class="input-group-text">Días</span>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="input-group input-group-sm w-auto">
                                <span class="input-group-text">Desde</span>
                                <input type="date" class="form-control form-control-sm"
                                       t-att-value="header.date_from"
                                       t-on-change="(ev) => this.onDateChange('date_from', ev)"/>
                                <span class="input-group-text">Hasta</span>
                                <input type="date" class="form-control form-control-sm"
                                       t-att-value="header.date_to"
                                       t-on-change="(ev) => this.onDateChange('date_to', ev)"/>
                            </div>
                        </t>
                        <!-- Cuentas (solo libro mayor de la empresa) -->
                        <select class="form-select form-select-sm w-auto"
                                t-if="header.report_type === 'partner_ledger'"
                                t-on-change="(ev) => this.updateFilter('account_type_filter', ev.target.value)">
                            <option value="both" t-att-selected="header.account_type_filter === 'both'">Cuenta: Contactos comerciales</option>
                            <option value="receivable" t-att-selected="header.account_type_filter === 'receivable'">Cuenta: Por cobrar</option>
                            <option value="payable" t-att-selected="header.account_type_filter === 'payable'">Cuenta: Por pagar</option>
                        </select>
                        <!-- Estado de resultados: comparación / orden / analíticas -->
                        <t t-if="header.report_type === 'profit_loss'">
                            <select class="form-select form-select-sm w-auto"
                                    t-on-change="(ev) => this.updateFilter('comparison_mode', ev.target.value)">
                                <option value="none" t-att-selected="header.comparison_mode === 'none'">Sin comparación</option>
                                <option value="previous_period" t-att-selected="header.comparison_mode === 'previous_period'">Períodos anteriores</option>
                                <option value="same_last_year" t-att-selected="header.comparison_mode === 'same_last_year'">Mismo período años anteriores</option>
                                <option value="custom" t-att-selected="header.comparison_mode === 'custom'">Fechas personalizadas</option>
                            </select>
                            <div class="input-group input-group-sm w-auto" style="max-width: 130px;"
                                 t-if="header.comparison_mode === 'previous_period' || header.comparison_mode === 'same_last_year'">
                                <input type="number" min="0" class="form-control form-control-sm"
                                       t-att-value="header.comparison_periods"
                                       t-on-change="onComparisonPeriodsChange"/>
                                <span class="input-group-text">Períodos</span>
                            </div>
                            <select class="form-select form-select-sm w-auto"
                                    t-if="header.comparison_mode !== 'none'"
                                    t-on-change="(ev) => this.updateFilter('period_order', ev.target.value)">
                                <option value="desc" t-att-selected="header.period_order === 'desc'">Descendente</option>
                                <option value="asc" t-att-selected="header.period_order === 'asc'">Ascendente</option>
                            </select>
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                    t-if="header.analytic_options.length"
                                    t-on-click="toggleAnalyticMenu">
                                Analítica<t t-if="header.analytic_ids.length"> (<t t-esc="header.analytic_ids.length"/>)</t>
                            </button>
                        </t>
                        <!-- Conciliación (solo libro mayor de la empresa) -->
                        <select class="form-select form-select-sm w-auto"
                                t-if="header.report_type === 'partner_ledger'"
                                t-on-change="(ev) => this.updateFilter('unreconciled_only', ev.target.value === 'unreconciled')">
                            <option value="all" t-att-selected="!header.unreconciled_only">Todos los apuntes</option>
                            <option value="unreconciled" t-att-selected="header.unreconciled_only">Sin conciliar</option>
                        </select>
                        <!-- Asientos -->
                        <select class="form-select form-select-sm w-auto"
                                t-on-change="(ev) => this.updateFilter('target_move', ev.target.value)">
                            <option value="posted" t-att-selected="header.target_move === 'posted'">Asientos registrados</option>
                            <option value="all" t-att-selected="header.target_move === 'all'">Todos los asientos</option>
                        </select>
                        <!-- Columnas: menú propio con position:fixed porque la
                             toolbar tiene overflow-x y recortaría un dropdown. -->
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                t-on-click="toggleColumnsMenu">Columnas</button>
                        <div class="btn-group" role="group">
                            <button class="btn btn-sm btn-outline-secondary" title="Desplegar todo"
                                    t-on-click="expandAll"><i class="fa fa-angle-double-down"/></button>
                            <button class="btn btn-sm btn-outline-secondary" title="Plegar todo"
                                    t-on-click="collapseAll"><i class="fa fa-angle-double-up"/></button>
                        </div>
                    </t>
                </div>
                <div class="o_arfr_banner text-center py-2" t-if="header and header.has_unposted">
                    Hay <strong>asientos contables sin registrar</strong> anteriores o incluidos en este período.
                </div>
            </div>

            <div class="o_content">
                <t t-if="state.loading"><p class="text-muted p-3">Cargando...</p></t>
                <t t-elif="state.error"><div class="alert alert-danger m-3" t-esc="state.error"/></t>
                <t t-elif="!groups.length">
                    <p class="text-muted p-3">No hay datos para los filtros seleccionados.</p>
                </t>
                <t t-else="">
                    <table class="table table-sm table-hover o_arfr_table">
                        <thead>
                            <tr>
                                <th class="o_arfr_col_name o_arfr_th_blank"/>
                                <t t-foreach="visibleColumnGroups" t-as="cg" t-key="cg_index">
                                    <th t-att-colspan="cg.colspan" class="text-center o_arfr_period">
                                        <t t-esc="cg.label"/>
                                    </th>
                                </t>
                            </tr>
                            <tr>
                                <th class="o_arfr_col_name"/>
                                <t t-foreach="visibleColumns" t-as="col" t-key="col.key">
                                    <th t-att-class="thClass(col)"><t t-esc="col.label"/></th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="filteredGroups" t-as="g" t-key="g.key">
                                <tr t-att-class="'o_arfr_group_row' + (g.style === 'total' ? ' o_arfr_row_total' : '')"
                                    t-on-click="() => this.toggleGroup(g.key)">
                                    <td class="o_arfr_col_name" t-att-title="g.name">
                                        <div class="o_arfr_name">
                                            <i t-if="g.has_lines !== false"
                                               t-att-class="'fa fa-fw me-1 text-muted ' + (state.expanded[g.key] ? 'fa-caret-down' : 'fa-caret-right')"/>
                                            <span t-else="" class="fa fa-fw me-1"/>
                                            <span class="o_arfr_name_text"><t t-esc="g.name"/></span>
                                            <i class="fa fa-spinner fa-spin ms-2 text-muted" t-if="state.loadingGroups[g.key]"/>
                                        </div>
                                    </td>
                                    <t t-foreach="visibleColumns" t-as="col" t-key="col.key">
                                        <t t-set="cell" t-value="getCell(g, col)"/>
                                        <td t-att-class="cellClass(col, cell) + (isDrillable(g, col, cell) ? ' o_arfr_drill' : '')"
                                            t-att-title="isDrillable(g, col, cell) ? 'Ver apuntes' : ''"
                                            t-on-click="(ev) => this.onGroupCellClick(g, col, ev)">
                                            <t t-esc="cell.display or ''"/>
                                        </td>
                                    </t>
                                </tr>
                                <t t-if="state.expanded[g.key]">
                                    <tr t-foreach="visibleLines(g)" t-as="ln"
                                        t-key="ln_index" class="o_arfr_line_row small">
                                        <td class="o_arfr_col_name"
                                            t-att-class="ln.is_initial ? 'fst-italic' : ''"
                                            t-att-title="ln.name">
                                            <div class="o_arfr_name ps-4">
                                                <span class="o_arfr_name_text">
                                                    <a href="#" t-if="ln.move_id" title="Abrir asiento"
                                                       t-on-click.prevent="() => this.openMove(ln)">
                                                        <t t-esc="ln.name"/>
                                                    </a>
                                                    <t t-else="" t-esc="ln.name"/>
                                                </span>
                                            </div>
                                        </td>
                                        <t t-foreach="visibleColumns" t-as="col" t-key="col.key">
                                            <t t-set="cell" t-value="getCell(ln, col)"/>
                                            <td t-att-class="cellClass(col, cell) + (ln.line_key and col.type === 'monetary' and cell.display ? ' o_arfr_drill' : '')"
                                                t-att-title="ln.line_key and col.type === 'monetary' and cell.display ? 'Ver apuntes' : ''"
                                                t-on-click="(ev) => this.onLineCellClick(g, ln, col, ev)">
                                                <t t-esc="cell.display or ''"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                        <tfoot t-if="hasTotals">
                            <tr class="fw-bold o_arfr_total_row">
                                <td class="o_arfr_col_name">Total</td>
                                <t t-foreach="visibleColumns" t-as="col" t-key="col.key">
                                    <t t-set="cell" t-value="getCell({values: totals}, col)"/>
                                    <td t-att-class="cellClass(col, cell)"><t t-esc="cell.display or ''"/></td>
                                </t>
                            </tr>
                        </tfoot>
                    </table>
                </t>
            </div>

            <!-- Menú de columnas flotante (fuera del contenedor con overflow). -->
            <t t-if="state.showColumnsMenu and header">
                <div class="o_arfr_menu_backdrop" t-on-click="closeColumnsMenu"/>
                <ul class="dropdown-menu show p-2 o_arfr_columns_menu"
                    t-attf-style="top: {{state.menuPos.top}}px; left: {{state.menuPos.left}}px;">
                    <li><a class="dropdown-item" href="#" t-on-click.prevent="showAllColumns">Mostrar todas</a></li>
                    <li><hr class="dropdown-divider"/></li>
                    <!-- Estado de resultados: ocultar por período completo -->
                    <t t-if="isPl">
                        <t t-foreach="columnMenuGroups" t-as="cmg" t-key="cmg_index">
                            <li>
                                <div class="dropdown-item form-check mb-0">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-id="'arfr_cg_' + cmg_index"
                                           t-att-checked="isGroupVisible(cmg)"
                                           t-on-change="() => this.toggleColumnGroup(cmg)"/>
                                    <label class="form-check-label" t-att-for="'arfr_cg_' + cmg_index">
                                        <t t-esc="cmg.label"/>
                                    </label>
                                </div>
                            </li>
                        </t>
                    </t>
                    <t t-else="">
                        <t t-foreach="header.columns" t-as="col" t-key="col.key">
                            <li>
                                <div class="dropdown-item form-check mb-0">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-id="'arfr_col_' + col.key"
                                           t-att-checked="!state.hiddenCols[col.key]"
                                           t-on-change="() => this.toggleColumn(col.key)"/>
                                    <label class="form-check-label" t-att-for="'arfr_col_' + col.key">
                                        <t t-esc="col.label"/>
                                    </label>
                                </div>
                            </li>
                        </t>
                    </t>
                    <li><hr class="dropdown-divider"/></li>
                    <li>
                        <div class="dropdown-item form-check mb-0">
                            <input type="checkbox" class="form-check-input" id="arfr_show_details"
                                   t-att-checked="header.show_details"
                                   t-on-change="(ev) => this.updateFilter('show_details', ev.target.checked)"/>
                            <label class="form-check-label" for="arfr_show_details">Detalle en PDF/Excel</label>
                        </div>
                    </li>
                </ul>
            </t>

            <!-- Menú de analíticas flotante (Estado de resultados). -->
            <t t-if="state.showAnalyticMenu and header">
                <div class="o_arfr_menu_backdrop" t-on-click="closeColumnsMenu"/>
                <ul class="dropdown-menu show p-2 o_arfr_columns_menu"
                    t-attf-style="top: {{state.menuPos.top}}px; left: {{state.menuPos.left}}px;">
                    <li class="dropdown-header">Subcolumnas por cuenta analítica</li>
                    <li class="px-2 pb-1">
                        <input type="text" class="form-control form-control-sm"
                               placeholder="Buscar cuenta..." t-model="state.analyticFilter"/>
                    </li>
                    <li class="px-2 pb-2" t-if="analyticPlans.length > 1">
                        <select class="form-select form-select-sm" t-on-change="onAnalyticPlanChange">
                            <option value="0" t-att-selected="!state.analyticPlanId">Todos los planes</option>
                            <t t-foreach="analyticPlans" t-as="plan" t-key="plan.id">
                                <option t-att-value="plan.id"
                                        t-att-selected="state.analyticPlanId === plan.id">
                                    <t t-esc="plan.name"/>
                                </option>
                            </t>
                        </select>
                    </li>
                    <t t-foreach="groupedAnalyticOptions" t-as="angrp" t-key="angrp_index">
                        <li class="dropdown-header o_arfr_plan_header"><t t-esc="angrp.plan_name"/></li>
                        <t t-foreach="angrp.options" t-as="an" t-key="an.id">
                            <li>
                                <div class="dropdown-item form-check mb-0">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-id="'arfr_an_' + an.id"
                                           t-att-checked="header.analytic_ids.includes(an.id)"
                                           t-on-change="() => this.toggleAnalytic(an.id)"/>
                                    <label class="form-check-label" t-att-for="'arfr_an_' + an.id">
                                        <t t-esc="an.name"/>
                                    </label>
                                </div>
                            </li>
                        </t>
                    </t>
                    <li class="px-2 text-muted small" t-if="!groupedAnalyticOptions.length">
                        Sin resultados
                    </li>
                </ul>
            </t>
        </div>
    </t>
</templates>
