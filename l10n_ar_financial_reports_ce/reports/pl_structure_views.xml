<?xml version="1.0" encoding="utf-8"?>
<!-- OJO versiones: Odoo 18/19 usan <tree>; la rama 17.0 lleva <tree>
     (se convierte al propagar). -->
<odoo>
    <record id="view_pl_structure_list" model="ir.ui.view">
        <field name="name">l10n_ar.pl.structure.list</field>
        <field name="model">l10n_ar.pl.structure</field>
        <field name="arch" type="xml">
            <tree string="Reportes Contables">
                <field name="name"/>
                <field name="report_kind"/>
            </tree>
        </field>
    </record>

    <record id="view_pl_structure_form" model="ir.ui.view">
        <field name="name">l10n_ar.pl.structure.form</field>
        <field name="model">l10n_ar.pl.structure</field>
        <field name="arch" type="xml">
            <form string="Reporte contable">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="report_kind"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="line_type"/>
                            <field name="account_prefixes"/>
                            <field name="account_tag_ids" widget="many2many_tags"
                                   optional="show" options="{'no_create': True}"/>
                            <field name="account_ids" widget="many2many_tags"
                                   optional="hide" options="{'no_create': True}"/>
                            <field name="formula"/>
                            <field name="balance_mode" optional="show"/>
                            <field name="sign" optional="show"/>
                            <field name="style"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pl_structure" model="ir.actions.act_window">
        <field name="name">Reportes Contables</field>
        <field name="res_model">l10n_ar.pl.structure</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_pl_structure" name="Reportes Contables"
              parent="account.menu_finance_configuration"
              action="action_pl_structure"
              groups="account.group_account_manager" sequence="99"/>
</odoo>
