<?xml version="1.0" encoding="utf-8"?>
<!-- OJO versiones: Odoo 18/19 usan <list>; la rama 17.0 lleva <tree>
     (se convierte al propagar). -->
<odoo>
    <record id="view_pl_structure_list" model="ir.ui.view">
        <field name="name">l10n_ar.pl.structure.list</field>
        <field name="model">l10n_ar.pl.structure</field>
        <field name="arch" type="xml">
            <list string="Estructuras de reportes">
                <field name="name"/>
                <field name="report_kind"/>
            </list>
        </field>
    </record>

    <record id="view_pl_structure_form" model="ir.ui.view">
        <field name="name">l10n_ar.pl.structure.form</field>
        <field name="model">l10n_ar.pl.structure</field>
        <field name="arch" type="xml">
            <form string="Estructura de Estado de Resultados">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="report_kind"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="line_type"/>
                            <field name="account_prefixes"/>
                            <field name="formula"/>
                            <field name="balance_mode"/>
                            <field name="sign"/>
                            <field name="style"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pl_structure" model="ir.actions.act_window">
        <field name="name">Estructuras Estado de Resultados</field>
        <field name="res_model">l10n_ar.pl.structure</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pl_structure" name="Estructuras Estado de Resultados"
              parent="account.menu_finance_configuration"
              action="action_pl_structure"
              groups="account.group_account_manager" sequence="99"/>
</odoo>
