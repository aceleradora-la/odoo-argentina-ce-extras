<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de líneas de impuestos para liquidación -->
    <record id="view_account_move_line_tree" model="ir.ui.view">
        <field name="name">Tax Journal Items Tree</field>
        <field name="model">account.move.line</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <!-- ocultamos algunos campos para simplificar vista -->
            <field name="debit" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="credit" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <!-- Asegurar que balance esté visible -->
            <field name="balance" position="attributes">
                <attribute name="invisible">0</attribute>
            </field>
            <field name="journal_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="date_maturity" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="account_id" position="after">
                <field name="tax_line_id"/>
            </field>
            <!-- Agregar botones de liquidación dentro del tree -->
            <xpath expr="//tree" position="inside">
                <field name="tax_state" invisible="1"/>
                <button name="button_create_tax_settlement_entry" 
                        icon="fa-arrow-right" 
                        help="Liquidar esta línea de impuesto" 
                        type="object" 
                        string="Liquidar"
                        class="btn-primary"
                        invisible="tax_state != 'to_settle'"/>
                <button name="action_open_tax_settlement_entry" 
                        icon="fa-external-link" 
                        help="Abrir asiento de liquidación" 
                        type="object" 
                        string="Abrir"
                        invisible="tax_state not in ['to_pay', 'paid']"/>
                <button name="action_pay_tax_settlement" 
                        icon="fa-dollar" 
                        help="Pagar liquidación" 
                        type="object" 
                        string="Pagar"
                        invisible="tax_state != 'to_pay'"/>
            </xpath>
        </field>
    </record>

    <!-- Acción para mostrar líneas de impuestos -->
    <record model="ir.actions.act_window" id="action_account_tax_move_line">
        <field name="name">Apuntes de Impuestos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.move.line</field>
        <field name="view_id" ref="view_account_move_line_tree"/>
        <field name="view_mode">tree</field>
        <field name="domain">[('tax_line_id', '!=', False)]</field>
        <field name="context">{'search_default_posted': 1}</field>
    </record>

</odoo>

