<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ar_tax_settlement_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ar.tax.settlement.wizard.form</field>
        <field name="model">l10n_ar.tax.settlement.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Liquidación de Impuestos">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group invisible="not file_content">
                        <field name="file_name" invisible="1"/>
                        <field name="file_content" filename="file_name" readonly="1" widget="binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" string="Generar Archivo" type="object" class="btn-primary" invisible="file_content"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ar_tax_settlement_wizard" model="ir.actions.act_window">
        <field name="name">Generar Liquidación TXT</field>
        <field name="res_model">l10n_ar.tax.settlement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_l10n_ar_tax_settlement_wizard"
              name="Generar Liquidación TXT"
              parent="account.menu_finance_reports"
              action="action_l10n_ar_tax_settlement_wizard"
              sequence="20"/>

</odoo>
