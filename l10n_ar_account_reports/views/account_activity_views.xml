<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Código de actividad AFIP en la ficha de la cuenta contable -->
    <record id="view_account_form_afip_activity" model="ir.ui.view">
        <field name="name">account.account.form.afip.activity</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <field name="l10n_ar_afip_activity_id"/>
            </field>
        </field>
    </record>

    <!-- Actividad AFIP por defecto en la ficha de la compañía -->
    <record id="view_company_form_afip_activity" model="ir.ui.view">
        <field name="name">res.company.form.afip.activity</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="l10n_ar_afip_activity_id"/>
            </field>
        </field>
    </record>
</odoo>
