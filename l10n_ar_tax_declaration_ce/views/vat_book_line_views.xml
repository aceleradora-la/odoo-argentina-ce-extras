<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista: replica el layout del Libro de IVA argentino (AR) de Enterprise -->
    <record id="view_l10n_ar_vat_book_line_list" model="ir.ui.view">
        <field name="name">l10n_ar.vat.book.line.list</field>
        <field name="model">l10n_ar.vat.book.line</field>
        <field name="arch" type="xml">
            <tree string="Libro de IVA Argentino" create="0" edit="0" delete="0">
                <header>
                    <button name="action_print_pdf" type="object" string="PDF" class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="XLSX" class="btn-secondary"/>
                    <button name="action_open_vat_book_zip" type="object" string="IVA Simple (ZIP)" class="btn-secondary"/>
                    <button name="action_open_tax_closing" type="object" string="Cierre de impuestos" class="btn-primary"/>
                </header>
                <field name="date"/>
                <field name="move_name"/>
                <field name="partner_id"/>
                <field name="afip_responsibility_type_id" optional="show"/>
                <field name="cuit" optional="show"/>
                <field name="journal_type" optional="hide"/>
                <field name="move_type" optional="hide"/>
                <field name="state" optional="hide"/>
                <field name="taxed" sum="Gravado"/>
                <field name="not_taxed" sum="No gravado"/>
                <field name="vat_25" sum="IVA 2,5%" optional="hide"/>
                <field name="vat_5" sum="IVA 5%" optional="hide"/>
                <field name="vat_10_5" sum="IVA 10,5%"/>
                <field name="vat_21" sum="IVA 21%"/>
                <field name="vat_27" sum="IVA 27%"/>
                <field name="perc_vat" sum="Perc. IVA"/>
                <field name="perc_iibb" sum="Perc. IIBB"/>
                <field name="perc_profits" sum="Gcia. perc." optional="show"/>
                <field name="municipal" sum="Municipales" optional="show"/>
                <field name="other_taxes" sum="Otros impuestos"/>
                <field name="total" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
                <button name="action_open_move" type="object" icon="fa-external-link" title="Ver comprobante"/>
            </tree>
        </field>
    </record>

    <!-- Pivot: resumen de IVA por mes / libro -->
    <record id="view_l10n_ar_vat_book_line_pivot" model="ir.ui.view">
        <field name="name">l10n_ar.vat.book.line.pivot</field>
        <field name="model">l10n_ar.vat.book.line</field>
        <field name="arch" type="xml">
            <pivot string="Resumen de IVA">
                <field name="journal_type" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="taxed" type="measure"/>
                <field name="not_taxed" type="measure"/>
                <field name="vat_10_5" type="measure"/>
                <field name="vat_21" type="measure"/>
                <field name="vat_27" type="measure"/>
                <field name="perc_vat" type="measure"/>
                <field name="perc_iibb" type="measure"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Búsqueda: por defecto mes anterior + registrados -->
    <record id="view_l10n_ar_vat_book_line_search" model="ir.ui.view">
        <field name="name">l10n_ar.vat.book.line.search</field>
        <field name="model">l10n_ar.vat.book.line</field>
        <field name="arch" type="xml">
            <search string="Libro de IVA Argentino">
                <field name="move_name"/>
                <field name="partner_id"/>
                <field name="cuit"/>
                <filter name="filter_last_month" string="Mes anterior"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')), ('date', '&lt;', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="filter_this_month" string="Mes actual"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="filter_date" date="date" string="Fecha"/>
                <separator/>
                <filter name="sales" string="Ventas" domain="[('journal_type', '=', 'sale')]"/>
                <filter name="purchases" string="Compras" domain="[('journal_type', '=', 'purchase')]"/>
                <separator/>
                <filter name="posted" string="Registrados" domain="[('state', '=', 'posted')]"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="groupby_journal_type" string="Libro (Ventas/Compras)" context="{'group_by': 'journal_type'}"/>
                    <filter name="groupby_partner" string="Contacto" context="{'group_by': 'partner_id'}"/>
                    <filter name="groupby_month" string="Mes" context="{'group_by': 'date:month'}"/>
                    <filter name="groupby_responsibility" string="Cond. IVA" context="{'group_by': 'afip_responsibility_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ar_vat_book_line" model="ir.actions.act_window">
        <field name="name">Declaración fiscal</field>
        <field name="res_model">l10n_ar.vat.book.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_l10n_ar_vat_book_line_search"/>
        <field name="context">{
            'search_default_filter_last_month': 1,
            'search_default_posted': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay comprobantes en el período seleccionado
            </p>
            <p>
                Esta vista muestra el Libro de IVA argentino: una fila por comprobante
                con los importes abiertos por alícuota de IVA y percepciones.
                Seleccione registros para imprimir PDF, exportar XLSX o generar
                el asiento de Cierre de impuestos.
            </p>
        </field>
    </record>
</odoo>
