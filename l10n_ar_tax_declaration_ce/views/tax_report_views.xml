<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ar_tax_report_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ar.tax.report.wizard.form</field>
        <field name="model">l10n_ar.tax.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Tax Report (AR)">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="only_posted"/>
                        </group>
                    </group>

                    <group>
                        <button name="action_compute" type="object" string="Calcular" class="btn-primary"/>
                        <button name="action_export_csv" type="object" string="Exportar CSV" class="btn-secondary"/>
                        <button name="action_open_lines" type="object" string="Ver apuntes (todos)" class="btn-secondary"/>
                    </group>

                    <group invisible="not file_content">
                        <field name="file_name" invisible="1"/>
                        <field name="file_content" filename="file_name" readonly="1" widget="binary"/>
                    </group>

                    <field name="line_ids" nolabel="1">
                        <list string="Líneas" create="0" delete="0">
                            <field name="tax_group_id"/>
                            <field name="tax_id"/>
                            <field name="base_amount" sum="Base"/>
                            <field name="tax_amount" sum="Impuesto"/>
                            <button name="action_drilldown" type="object" string="Detalle" class="btn-link"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

