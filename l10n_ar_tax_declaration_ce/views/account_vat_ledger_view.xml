<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión del form del Libro IVA de ingadhoc: IVA Simple (ZIP) + Cierre de impuestos -->
    <record id="account_vat_ledger_form_tax_declaration" model="ir.ui.view">
        <field name="name">account.vat.ledger.form.tax.declaration</field>
        <field name="model">account.vat.ledger</field>
        <field name="inherit_id" ref="l10n_ar_reports.account_vat_ledger_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="tax_closing_move_id" invisible="1"/>
                <field name="tax_closing_payment_state" invisible="1"/>
                <button name="action_open_tax_closing"
                        string="Asiento de cierre"
                        type="object"
                        invisible="tax_closing_move_id"/>
                <button name="action_view_tax_closing_move"
                        string="Ver asiento de cierre"
                        type="object"
                        invisible="not tax_closing_move_id"/>
                <button name="action_pay_tax_closing"
                        string="Pagar cierre"
                        type="object"
                        class="btn-primary"
                        invisible="tax_closing_payment_state != 'to_pay'"/>
            </xpath>
            <xpath expr="//field[@name='prorate_type']" position="after">
                <field name="libro_iva_currency_mode"/>
            </xpath>
            <!-- El port a Odoo 19 de l10n_ar_reports quitó de la vista los
                 readonly="state != 'draft'", pero el modelo sigue definiendo
                 estos campos con readonly=True + states (ignorado desde Odoo
                 17): quedaban siempre bloqueados y no se podía cargar el
                 período de un Libro nuevo. Restauramos el override de vista.
                 En 17/18 la vista base ya trae el mismo atributo (idempotente). -->
            <xpath expr="//field[@name='company_id'][@widget='selection']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='date_from']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='date_to']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='presented_ledger']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='first_page']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='last_page']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_ids']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//page[@name='txt_files']" position="after">
                <page string="IVA Simple (ZIP)" name="iva_simple">
                    <button name="compute_iva_simple_data"
                            type="object"
                            string="Generar IVA Simple (ZIP)"
                            invisible="state != 'draft'"/>
                    <group>
                        <group>
                            <field name="iva_simple_filename" invisible="1"/>
                            <field name="iva_simple_file" filename="iva_simple_filename"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
