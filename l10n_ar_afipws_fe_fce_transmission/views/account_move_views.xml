<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fce_transmission" model="ir.ui.view">
        <field name="name">account.move.form.fce.transmission.mode</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Estrategia múltiple: intentar varios lugares donde puede estar el campo -->
            <!-- 1. Después de afip_fce_es_anulacion si existe -->
            <xpath expr="//field[@name='afip_fce_es_anulacion']" position="after">
                <field name="l10n_ar_afip_fce_transmission"
                       invisible="not l10n_latam_document_type_id or l10n_latam_document_type_id.code not in ['111', '112', '113', '114', '201', '202', '203', '206', '207', '208'] or move_type != 'out_invoice'"
                       options="{'no_create': True}"/>
            </xpath>
            <!-- 2. Después de l10n_latam_document_type_id (campo que siempre existe en facturas argentinas) -->
            <!-- Temporalmente visible para debug - luego restaurar la condición invisible -->
            <xpath expr="//field[@name='l10n_latam_document_type_id']" position="after">
                <field name="l10n_ar_afip_fce_transmission"
                       invisible="move_type != 'out_invoice'"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
